# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (T09). The service-role key is server-only: never expose it to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Esri satellite imagery developer key (T12). Map tiles load in the browser, so this one is public by design; restrict it by referrer in the Esri dashboard.
NEXT_PUBLIC_ESRI_API_KEY=

# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (T09). Leave all three empty to use the in-memory store (data is lost on restart).
# The service-role key is server-only: only src/lib/store/server.ts reads it, and it must never get a NEXT_PUBLIC_ name.
# SUPABASE_ANON_KEY is not used by stage 1 code; every database call goes through the server with the service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Esri satellite imagery developer key (T12). Map tiles load in the browser, so this one is public by design; restrict it by referrer in the Esri dashboard.
NEXT_PUBLIC_ESRI_API_KEY=
